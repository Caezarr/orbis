# Server-only credentials. Never use NEXT_PUBLIC_ for these values.
ORBIS_AI_PROVIDER=openai
ORBIS_AI_MODEL=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Create a separate least-privilege auth configuration per tool in your project.
COMPOSIO_API_KEY=
COMPOSIO_AUTH_CONFIG_GMAIL=
COMPOSIO_AUTH_CONFIG_OUTLOOK=
COMPOSIO_AUTH_CONFIG_GOOGLECALENDAR=
COMPOSIO_AUTH_CONFIG_GOOGLEDRIVE=
COMPOSIO_AUTH_CONFIG_NOTION=
COMPOSIO_AUTH_CONFIG_SLACK=

# Direct business adapters: do not assume these are covered by the tool broker.
HOSTAWAY_ACCOUNT_ID=
HOSTAWAY_CLIENT_SECRET=
HOSTAWAY_ALLOWED_LISTING_IDS=
HF_API_KEY_ID=
HF_API_KEY_SECRET=
