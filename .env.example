# Server-only credentials. Never use NEXT_PUBLIC_ for these values.
ORBIS_AI_PROVIDER=openai
ORBIS_AI_MODEL=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Stripe Billing (server-only; use a restricted key in production). TEST MODE
# until the owner validates prices. Displayed prices are read from these Stripe
# Price objects; unset/invalid = "Tarif bientôt disponible" + checkout disabled.
# See docs/product/billing-v1.md. Verify which Stripe account the ids below
# belong to before reusing them.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_SOLO_MONTHLY=price_1UEuVbHtk3rRhHLodiejA0m9
# Equipe plan (flat monthly price, quantity 1). Falls back to the legacy
# STRIPE_PRICE_BUSINESS_BASE_MONTHLY when unset.
STRIPE_PRICE_EQUIPE_MONTHLY=
STRIPE_PRICE_BUSINESS_BASE_MONTHLY=price_1UEuVfHtk3rRhHLo69Lubaqa
# Legacy, unused since V1 plans (no seat add-on): kept for reference only.
STRIPE_PRICE_BUSINESS_EXTRA_SEAT_MONTHLY=price_1UEuVyHtk3rRhHLoeVv6YYZT

# V1 plans and trial (defaults shown; invalid values fall back to defaults).
# Trial = N days OR N drafts, whichever comes first; starts at the first mailbox batch.
ORBIS_TRIAL_DAYS=14
ORBIS_TRIAL_DRAFTS=50
# Monthly model-cost caps in ESTIMATED cents, synced per workspace and clamped
# by billing_plan_caps (migration 010); ORBIS_OPERATIONS_MONTHLY_CAP_CENTS must be >= the highest.
ORBIS_TRIAL_CAP_CENTS=800
ORBIS_PLAN_SOLO_DRAFTS=300
ORBIS_PLAN_SOLO_MAILBOXES=1
ORBIS_PLAN_SOLO_CAP_CENTS=3000
ORBIS_PLAN_EQUIPE_DRAFTS=1500
ORBIS_PLAN_EQUIPE_MAILBOXES=5
ORBIS_PLAN_EQUIPE_CAP_CENTS=15000
# Internal pilots without Stripe only: "false" disables trial/quota enforcement.
ORBIS_ENTITLEMENTS_ENFORCED=true
# Public HTTPS origin in production; no implicit localhost fallback.
ORBIS_APP_URL=

# Auth and durable tenant storage. Configure in deployment secrets, not source.
APP_ORIGIN=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
DATABASE_URL=
MIGRATION_DATABASE_URL=
DATABASE_APP_ROLE=
# Explicit local demonstration only. Never enabled on Vercel/production.
ORBIS_OFFLINE=false

# Read-only operational worker. Enable only after database and provider checks.
ORBIS_OPERATIONS_ENABLED=false
ORBIS_OPERATIONS_MONTHLY_CAP_CENTS=
ORBIS_WORKER_USER_ID=
ORBIS_WORKER_WORKSPACE_ID=
ORBIS_WORKER_TENANT_ID=

# Optional server-side product analytics. No document content or session replay.
POSTHOG_ENABLED=false
POSTHOG_PROJECT_KEY=
POSTHOG_HOST=https://eu.i.posthog.com

# Accepted-task per-task Checkout: NOT part of V1 (drafts are quota units, never
# charged per unit). Keep false; the task ledger UI is hidden while false.
# Opt in only after reviewing task rates/inclusions and completing Stripe setup.
# Tasks queued before activation remain previews and are never charged retroactively.
ORBIS_TASK_BILLING_ENABLED=false

# Create a separate least-privilege auth configuration per tool in your project.
COMPOSIO_API_KEY=
COMPOSIO_AUTH_CONFIG_GMAIL=
COMPOSIO_AUTH_CONFIG_OUTLOOK=
COMPOSIO_AUTH_CONFIG_GOOGLECALENDAR=
COMPOSIO_AUTH_CONFIG_GOOGLEDRIVE=
COMPOSIO_AUTH_CONFIG_SHAREPOINT=
# Set the exact toolkit slug configured in your integration project.
COMPOSIO_TOOLKIT_SHAREPOINT=
COMPOSIO_AUTH_CONFIG_NOTION=
COMPOSIO_AUTH_CONFIG_SLACK=

# V1 focus (docs/strategy/17-v1-self-serve.md). The horizontal product (catalogue,
# missions, workflows, knowledge, analytics, integrations catalogue, old audit and
# onboarding, Ask Orbi chat) is frozen: hidden from the workspace and its routes
# redirect to the wedge (see src/lib/product/surfaces.ts). true = expose it again.
# Read at build time by static pages (nav, sitemap): redeploy after changing it.
ORBIS_FROZEN_SURFACES_ENABLED=false

# Inbox reply drafts (Gmail/Outlook via Composio). Reads inbound mail and creates
# reply DRAFTS only; this path can never send. Off by default. See
# docs/product/inbox-drafts.md before enabling. Requires the operations worker,
# ORBIS_OPERATIONS_MONTHLY_CAP_CENTS and COMPOSIO_AUTH_CONFIG_GMAIL/_OUTLOOK with
# read + compose scopes only.
ORBIS_INBOX_DRAFTS_ENABLED=false
# test = classify and simulate drafts (no mailbox write); scoped_autonomy = create
# real drafts under policy inbox-drafts-v1. Defaults to test when unset.
ORBIS_INBOX_MODE=test
# Pinned Composio toolkit versions (YYYYMMDD_NN), checked against the tool registry.
COMPOSIO_TOOL_VERSION_GMAIL=
COMPOSIO_TOOL_VERSION_OUTLOOK=
# Optional: drafts per first run (default 5); estimated cents reserved per model call
# against the monthly cap (defaults 1 and 5); cheaper triage model, same provider.
ORBIS_INBOX_FIRST_RUN_MAX_DRAFTS=5
ORBIS_INBOX_EST_CENTS_CLASSIFY=1
ORBIS_INBOX_EST_CENTS_DRAFT=5
ORBIS_AI_CLASSIFIER_MODEL=
# Worker job selection for scripts/operations-worker.ts: all | tasks | inbox | dispatch
# (dispatch = one multi-tenant inbox pass, no ORBIS_WORKER_*_ID needed).
ORBIS_WORKER_JOB=all
# Multi-tenant inbox scheduler (GET/POST /api/cron/inbox). Bearer secret for the
# cron route, at least 32 characters (openssl rand -hex 32). Unset = route returns 503.
CRON_SECRET=
# Optional per-pass bounds (defaults shown): batches per pass, batches per
# workspace per pass, workspaces discovered per pass, wall-clock budget and the
# margin under which no new batch/message is started.
ORBIS_SCHEDULER_MAX_BATCHES=10
ORBIS_SCHEDULER_MAX_PER_WORKSPACE=2
ORBIS_SCHEDULER_MAX_WORKSPACES=50
ORBIS_SCHEDULER_BUDGET_MS=50000
ORBIS_SCHEDULER_RESERVE_MS=15000
# Continuous drafting (per-workspace opt-in): poll interval for new workspaces
# (5-1440, default 15) and drafts per incremental batch (default 10).
ORBIS_INBOX_POLL_MINUTES=15
ORBIS_INBOX_CONTINUOUS_MAX_DRAFTS=10
# Default monthly cap per workspace in cents (unset = ORBIS_OPERATIONS_MONTHLY_CAP_CENTS).
# A workspace's stored cap (plan sync orbis_sync_workspace_plan_cap, or the
# operator's orbis_set_workspace_inbox_cap) overrides it; the
# global ORBIS_OPERATIONS_MONTHLY_CAP_CENTS always remains the hard ceiling.
ORBIS_WORKSPACE_MONTHLY_CAP_CENTS=
# /start step 1 is public (no account). When true AND a model provider is
# configured, the public site reading is structured by the model (verbatim-quote
# validated); otherwise the profile is quote-only, with no model cost. The
# public route has only per-instance rate limits: add an edge/WAF limit first.
ORBIS_START_AI_PROFILE=false
# /start level 1 instant preview (anonymous, after the profile is confirmed):
# likely customer questions with verbatim-sourced answers + 2 simulated example
# drafts. Model calls only when true AND a provider is configured; otherwise a
# quote-only view (no model). Limits are per instance (memory): 3 generations/h
# per IP, 2 concurrent, one per profile hash (6 h cache), and daily budgets in
# cents reserved before each generation (estimate per preview, default 15).
# See docs/product/start-preview.md.
ORBIS_START_PREVIEW=false
ORBIS_START_PREVIEW_DAILY_CAP_CENTS=150
ORBIS_START_PREVIEW_IP_DAILY_CAP_CENTS=30
ORBIS_START_PREVIEW_EST_CENTS=15

# Direct business adapters: do not assume these are covered by the tool broker.
HOSTAWAY_ACCOUNT_ID=
HOSTAWAY_CLIENT_SECRET=
HOSTAWAY_ALLOWED_LISTING_IDS=
HF_API_KEY_ID=
HF_API_KEY_SECRET=

# Launch hardening (Phase 4) — see docs/product/launch-checklist.md
# Sign-in methods. OAuth buttons appear ONLY when the provider is configured in Supabase Auth.
ORBIS_AUTH_PASSWORD=true
ORBIS_AUTH_MAGIC_LINK=true
ORBIS_AUTH_GOOGLE=false
ORBIS_AUTH_MICROSOFT=false
# Server-only. Enables deletion of the Supabase Auth identity on account deletion.
SUPABASE_SERVICE_ROLE_KEY=
# Shared (Postgres) rate limits on public endpoints; HMAC key for hashed limiter keys.
ORBIS_SHARED_LIMITS=true
ORBIS_RATE_LIMIT_SECRET=
# Error monitoring (optional, PII-scrubbed). Server errors, and browser errors relayed
# same-origin by /api/client-errors; the DSN is never sent to the browser.
SENTRY_DSN=
