digraph G { rankdir=LR; graph [bgcolor="transparent", pad="0.2"]; node [shape=box, style="rounded,filled", fontname="Arial", fontsize=14, color="#D6D9E0", fillcolor="#F7F8FA", margin="0.18,0.12"]; edge [color="#687184", penwidth=1.5, arrowsize=.7]; A [label="Website or explanation", fillcolor="#EAF2FF"]; B [label="Company profile\nfacts + hypotheses"]; C [label="Recommendations\nmarketplace + free-form"]; D [label="Mission\nknowledge + instructions + tools"]; E [label="Evaluation lab\nevidence + correction"]; F [label="Supervised activation", fillcolor="#E9F8F2"]; G [label="Measured runs\nquality + cost + memory"]; A->B->C->D->E->F->G; G->D [label="improves next run", fontname="Arial", fontsize=10, color="#20A47B"]; }
