digraph G { rankdir=TB; graph [bgcolor="transparent", pad="0.2"]; node [shape=box, style="rounded,filled", fontname="Arial", fontsize=13, color="#D6D9E0", fillcolor="#F7F8FA", margin="0.16,0.12"]; edge [color="#687184", penwidth=1.4, arrowsize=.7]; OUT [label="Business outcome", fillcolor="#EAF2FF"]; PRO [label="Capability protocol\nsteps · inputs · outputs · approvals"]; HAR [label="Agent harness\ncontext · tools · limits · escalation"]; MEM [label="Company context\nknowledge · memory · instructions"]; EVA [label="Evaluation suite\nquality · cost · safety · acceptance"]; RUN [label="Runtime execution\ntest · supervised · autonomous", fillcolor="#E9F8F2"]; OUT->PRO->HAR; MEM->HAR; HAR->EVA->RUN; }
